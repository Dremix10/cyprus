{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "testflight": {
      "distribution": "store",
      "channel": "preview",
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://aegist.dev"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6819067929"
      }
    }
  }
}
