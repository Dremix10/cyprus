{
  "expo": {
    "name": "Titsu",
    "slug": "titsu",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "titsu",
    "primaryColor": "#0F5132",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.growzonecy.cyprus",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3B26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    },
    "icon": "./assets/images/icon.png",
    "owner": "growzone-cy"
  }
}
