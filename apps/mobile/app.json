{
  "expo": {
    "name": "Titsu",
    "slug": "titsu",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "titsu",
    "primaryColor": "#1A1A2E",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.aegist.titsu",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa6e1148-a0f6-4773-9be9-6aef33a39323"
      }
    },
    "icon": "./assets/images/icon.png",
    "owner": "growzone-cy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fa6e1148-a0f6-4773-9be9-6aef33a39323"
    },
    "android": {}
  }
}
