{
  "name": "cyprus-e2e-web",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright end-to-end tests for the Cyprus Tichu web client (runs against an isolated QA server on :3311).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "qa-server": "bash scripts/start-qa-server.sh",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
