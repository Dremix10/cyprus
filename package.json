{
  "name": "cyprus",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently \"npm run dev --workspace=packages/server\" \"npm run dev --workspace=packages/client\"",
    "start": "NODE_ENV=production node packages/server/dist/index.js",
    "bot:arena": "npm run arena --workspace=packages/server --",
    "bot:audit": "npm run audit --workspace=packages/server --",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "clean": "rm -rf packages/*/dist packages/client/dist-dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.0.0"
  }
}
